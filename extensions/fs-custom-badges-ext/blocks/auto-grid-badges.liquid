{% unless request.page_type == 'product' %}
<script>
  document.addEventListener("DOMContentLoaded", async function() {
    // CRITICAL FIX: Strictly prevent this script from running on product pages
    if (window.location.pathname.includes('/products/')) return;

    const shopDomain = Shopify.shop || "{{ shop.permanent_domain }}";
    const apiUrl = `/apps/badges?shop=${shopDomain}`;

    try {
      const response = await fetch(apiUrl);
      const data = await response.json();

      if (data.success && data.badges && data.badges.length > 0) {
        
        // 1. Inject Global Custom CSS
        if (data.globalCustomCss) {
          const style = document.createElement('style');
          style.innerHTML = data.globalCustomCss;
          document.head.appendChild(style);
        }

        // 2. Theme Customizer Selector
        const cardSelector = "{{ block.settings.card_selector }}";
        const productCards = document.querySelectorAll(cardSelector);

        productCards.forEach(card => {
          const productLink = card.querySelector('a[href*="/products/"]');
          if (!productLink) return;

          // Attempt to pull product ID if the theme supports it for specific badge targeting
          const cardProductId = card.getAttribute('data-product-id') || 
                               (card.querySelector('[data-product-id]') ? card.querySelector('[data-product-id]').getAttribute('data-product-id') : null);

          let activeBadge = null;

          // Check if a specific product badge exists for this card first
          if (cardProductId) {
            activeBadge = data.badges.find(b => b.targetType === 'SPECIFIC_PRODUCTS' && b.productIds.includes(String(cardProductId)));
          }

          // Fallback to highest priority global badge
          if (!activeBadge) {
            activeBadge = data.badges.find(b => b.isGlobal || b.targetType === 'GLOBAL');
          }
          
          if (activeBadge) {
            const badgeElement = document.createElement('div');
            
            // Apply Database Styles
            const bg = activeBadge.shape === 'OUTLINE' ? 'transparent' : activeBadge.bgColor;
            const color = activeBadge.shape === 'OUTLINE' ? activeBadge.bgColor : activeBadge.textColor;
            const border = `1px solid ${activeBadge.borderColor || activeBadge.bgColor}`;
            const radius = activeBadge.shape === 'PILL' ? '999px' : (activeBadge.shape === 'SHARP' ? '0px' : activeBadge.borderRadius + 'px');
            
            badgeElement.style.cssText = `
              position: absolute;
              top: 10px;
              left: 10px;
              z-index: 2;
              background: ${bg};
              color: ${color};
              border: ${border};
              border-radius: ${radius};
              padding: ${activeBadge.paddingY}px ${activeBadge.paddingX}px;
              font-size: ${activeBadge.fontSize}px;
              font-weight: ${activeBadge.fontWeight};
              display: inline-flex;
              align-items: center;
              gap: 4px;
              ${activeBadge.customCss}
            `;
            
            badgeElement.innerHTML = `${activeBadge.icon ? `<span>${activeBadge.icon}</span>` : ''} <span>${activeBadge.text}</span>`;
            
            card.style.position = 'relative'; // Ensure parent is relative
            card.appendChild(badgeElement);
          }
        });
      }
    } catch (error) {
      console.error("FS Custom Badges Error:", error);
    }
  });
</script>
{% endunless %}

{% schema %}
{
  "name": "Auto Grid Badges",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "card_selector",
      "label": "Product Card Selector",
      "default": ".card, .product-card, .grid-view-item",
      "info": "CSS selector for product grid items (e.g. .card for Dawn theme)"
    }
  ]
}
{% endschema %}