{% unless request.page_type == 'product' %}
<script>
  document.addEventListener("DOMContentLoaded", async function() {
    if (window.location.pathname.includes('/products/')) return;

    const shopDomain = Shopify.shop || "{{ shop.permanent_domain }}";
    const apiUrl = `/apps/badges?shop=${shopDomain}`;

    try {
      const response = await fetch(apiUrl);
      const data = await response.json();

      if (data.success && data.badges && data.badges.length > 0) {
        if (data.globalCustomCss) {
          const style = document.createElement('style');
          style.innerHTML = data.globalCustomCss;
          document.head.appendChild(style);
        }

        const cardSelector = "{{ block.settings.card_selector }}";
        const productCards = document.querySelectorAll(cardSelector);

        productCards.forEach(card => {
          const productLink = card.querySelector('a[href*="/products/"]');
          if (!productLink) return;

          const urlPath = new URL(productLink.href, window.location.origin).pathname;
          const pathParts = urlPath.split('/products/');
          const productHandle = pathParts.length > 1 ? pathParts[1].split('?')[0].split('/')[0] : '';

          let activeBadge = null;

          if (productHandle) {
            activeBadge = data.badges.find(b => b.targetType === 'SPECIFIC_PRODUCTS' && b.productHandles && b.productHandles.includes(productHandle));
          }

          if (!activeBadge) {
            activeBadge = data.badges.find(b => b.isGlobal || b.targetType === 'GLOBAL');
          }
          
          if (activeBadge) {
            let shapeCss = '';
            let wrapperFilter = 'none';
            const bg = activeBadge.shape === 'OUTLINE' ? 'transparent' : (activeBadge.bgColor || '#DC2626');
            const color = activeBadge.shape === 'OUTLINE' ? (activeBadge.bgColor || '#DC2626') : (activeBadge.textColor || '#FFFFFF');
            const border = activeBadge.shape === 'OUTLINE' ? `1px solid ${bg}` : `1px solid ${activeBadge.borderColor || bg}`;
            
            // Generate actual ribbon and starburst cuts using clip-path polygons
            if (activeBadge.shape === 'RIBBON_BANNER') {
              shapeCss = `
                background: ${bg}; color: ${color}; border: none; border-radius: 0;
                padding: ${activeBadge.paddingY || 6}px ${(activeBadge.paddingX || 12) + 12}px ${activeBadge.paddingY || 6}px ${activeBadge.paddingX || 12}px;
                clip-path: polygon(0 0, 85% 0, 100% 50%, 85% 100%, 0 100%);
              `;
              wrapperFilter = 'drop-shadow(0px 4px 6px rgba(0,0,0,0.35))';
            } else if (activeBadge.shape === 'STARBURST') {
              shapeCss = `
                background: ${bg}; color: ${color}; border: none; border-radius: 0;
                padding: ${(activeBadge.paddingY || 6) + 12}px ${(activeBadge.paddingX || 12) + 8}px;
                clip-path: polygon(50% 0%, 61% 15%, 79% 9%, 83% 26%, 100% 33%, 93% 50%, 100% 67%, 83% 74%, 79% 91%, 61% 85%, 50% 100%, 39% 85%, 21% 91%, 25% 74%, 0% 67%, 7% 50%, 0% 33%, 25% 26%, 21% 9%, 39% 15%);
              `;
              wrapperFilter = 'drop-shadow(0px 4px 6px rgba(0,0,0,0.35))';
            } else if (activeBadge.shape === 'CORNER_FOLD') {
              shapeCss = `
                background: ${bg}; color: ${color}; border: none; border-radius: 0;
                padding: ${activeBadge.paddingY || 6}px ${activeBadge.paddingX || 12}px ${activeBadge.paddingY || 6}px ${(activeBadge.paddingX || 12) + 12}px;
                clip-path: polygon(15% 0, 100% 0, 100% 100%, 15% 100%, 0 50%);
              `;
              wrapperFilter = 'drop-shadow(0px 4px 6px rgba(0,0,0,0.35))';
            } else if (activeBadge.shape === 'FOLDED_RIBBON') {
              shapeCss = `
                background: ${bg}; color: ${color}; border: none; border-radius: 0;
                padding: ${activeBadge.paddingY || 6}px ${(activeBadge.paddingX || 12) + 10}px;
                clip-path: polygon(10% 0, 90% 0, 100% 50%, 90% 100%, 10% 100%, 0 50%);
              `;
              wrapperFilter = 'drop-shadow(0px 4px 6px rgba(0,0,0,0.35))';
            } else {
              const radius = activeBadge.shape === 'PILL' ? '999px' : (activeBadge.shape === 'SHARP' ? '0px' : activeBadge.borderRadius + 'px');
              shapeCss = `
                background: ${bg}; color: ${color}; border: ${border}; border-radius: ${radius};
                padding: ${activeBadge.paddingY}px ${activeBadge.paddingX}px;
                box-shadow: 0 3px 10px rgba(0,0,0,0.2);
              `;
            }

            // Wrapper is required because clip-path hides drop-shadows otherwise
            const wrapper = document.createElement('div');
            wrapper.style.cssText = `
              position: absolute;
              top: 10px;
              left: 10px;
              z-index: 2;
              filter: ${wrapperFilter};
            `;

            const badgeElement = document.createElement('div');
            badgeElement.style.cssText = `
              font-size: ${activeBadge.fontSize}px;
              font-weight: ${activeBadge.fontWeight};
              display: inline-flex;
              align-items: center;
              justify-content: center;
              gap: 4px;
              text-transform: uppercase;
              ${shapeCss}
              ${activeBadge.customCss}
            `;
            
            badgeElement.innerHTML = `${activeBadge.icon ? `<span>${activeBadge.icon}</span>` : ''} <span>${activeBadge.text}</span>`;
            
            wrapper.appendChild(badgeElement);
            card.style.position = 'relative';
            card.appendChild(wrapper);
          }
        });
      }
    } catch (error) {
      console.error("FS Custom Badges Error:", error);
    }
  });
</script>
{% endunless %}

{% schema %}
{
  "name": "Auto Grid Badges",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "card_selector",
      "label": "Product Card Selector",
      "default": ".card, .product-card, .grid-view-item",
      "info": "CSS selector for product grid items (e.g. .card for Dawn theme)"
    }
  ]
}
{% endschema %}