<div class="fs-badge-container" {{ block.shopify_attributes }}>
  <div style="
    background: {% if block.settings.shape == 'OUTLINE' %}transparent{% else %}{{ block.settings.bg_color }}{% endif %};
    color: {% if block.settings.shape == 'OUTLINE' %}{{ block.settings.bg_color }}{% else %}{{ block.settings.text_color }}{% endif %};
    border: 1px solid {{ block.settings.border_color | default: block.settings.bg_color }};
    border-radius: {% if block.settings.shape == 'PILL' %}999px{% elsif block.settings.shape == 'SHARP' %}0px{% else %}{{ block.settings.border_radius }}px{% endif %};
    padding: {{ block.settings.padding_y }}px {{ block.settings.padding_x }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    display: inline-flex;
    align-items: center;
    gap: 5px;
    text-transform: uppercase;
  ">
    {% if block.settings.icon != blank %}
      <span>{{ block.settings.icon }}</span>
    {% endif %}
    <span>{{ block.settings.custom_text }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Custom Product Badge",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "custom_text",
      "label": "Badge Text",
      "default": "HOT SELLER"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon",
      "default": "🔥"
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Shape",
      "options": [
        { "label": "Pill", "value": "PILL" },
        { "label": "Sharp", "value": "SHARP" },
        { "label": "Outline", "value": "OUTLINE" }
      ],
      "default": "PILL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2563EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#1D4ED8"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "label": "Border Radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "label": "Font Size",
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "label": "Regular", "value": "400" },
        { "label": "Medium", "value": "500" },
        { "label": "Bold", "value": "bold" },
        { "label": "Extra Bold", "value": "800" }
      ],
      "default": "bold"
    },
    {
      "type": "range",
      "id": "padding_x",
      "min": 4,
      "max": 30,
      "step": 1,
      "label": "Horizontal Padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Vertical Padding",
      "default": 4
    }
  ]
}
{% endschema %}