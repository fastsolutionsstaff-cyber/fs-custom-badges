<div id="fs-custom-badge-{{ block.id }}" class="fs-badge-container">
  {% if block.settings.use_dashboard == false %}
    <!-- Manual Customization via Theme Editor -->
    <div style="
      background: {{ block.settings.bg_color }};
      color: {{ block.settings.text_color }};
      border: 1px solid {{ block.settings.border_color }};
      border-radius: {{ block.settings.border_radius }}px;
      padding: 6px 12px;
      font-size: {{ block.settings.font_size }}px;
      font-weight: bold;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    ">
      <span>{{ block.settings.custom_text }}</span>
    </div>
  {% endif %}
</div>

{% if block.settings.use_dashboard %}
<script>
  document.addEventListener("DOMContentLoaded", async function() {
    const container = document.getElementById("fs-custom-badge-{{ block.id }}");
    const shopDomain = Shopify.shop || "{{ shop.permanent_domain }}";
    const productId = "{{ product.id }}";
    
    // Fetch specifically for this product
    const apiUrl = `/apps/badges?shop=${shopDomain}&productId=${productId}`;

    try {
      const response = await fetch(apiUrl);
      const data = await response.json();

      if (data.success && data.badges && data.badges.length > 0) {
        const badge = data.badges[0]; // Load highest priority badge for this product
        
        const bg = badge.shape === 'OUTLINE' ? 'transparent' : badge.bgColor;
        const color = badge.shape === 'OUTLINE' ? badge.bgColor : badge.textColor;
        const border = `1px solid ${badge.borderColor || badge.bgColor}`;
        const radius = badge.shape === 'PILL' ? '999px' : (badge.shape === 'SHARP' ? '0px' : badge.borderRadius + 'px');

        container.innerHTML = `
          <div style="
            background: ${bg};
            color: ${color};
            border: ${border};
            border-radius: ${radius};
            padding: ${badge.paddingY}px ${badge.paddingX}px;
            font-size: ${badge.fontSize}px;
            font-weight: ${badge.fontWeight};
            display: inline-flex;
            align-items: center;
            gap: 4px;
            ${badge.customCss}
          ">
            ${badge.icon ? `<span>${badge.icon}</span>` : ''}
            <span>${badge.text}</span>
          </div>
        `;
      }
    } catch (error) {
      console.error("FS Custom Badges Fetch Error:", error);
    }
  });
</script>
{% endif %}

{% schema %}
{
  "name": "Custom Product Badge",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "checkbox",
      "id": "use_dashboard",
      "label": "Use App Dashboard Settings",
      "default": true,
      "info": "If checked, it fetches settings automatically from your app."
    },
    {
      "type": "header",
      "content": "Manual Settings (If Dashboard is off)"
    },
    {
      "type": "text",
      "id": "custom_text",
      "label": "Badge Text",
      "default": "HOT SELLER"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2563EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#1D4ED8"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "label": "Border Radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "label": "Font Size",
      "default": 13
    }
  ]
}
{% endschema %}