<script>
  (function () {
    "use strict";

    if (window.location.pathname.includes("/products/")) {
      return;
    }

    const API_ENDPOINT = "/apps/badges";
    const SHOP_DOMAIN = "{{ shop.permanent_domain }}";

    let badgeConfiguration = [];
    let engineInitialized = false;

    async function loadBadges() {
      try {
        const response = await fetch(
          `${API_ENDPOINT}?shop=${encodeURIComponent(SHOP_DOMAIN)}`,
          {
            method: "GET",
            credentials: "same-origin",
            cache: "no-store"
          }
        );

        if (!response.ok) return false;

        const data = await response.json();
        badgeConfiguration = Array.isArray(data.badges) ? data.badges : [];

        if (
          data.globalCustomCss &&
          !document.getElementById("fs-custom-badges-global-css")
        ) {
          const style = document.createElement("style");
          style.id = "fs-custom-badges-global-css";
          style.textContent = data.globalCustomCss;
          document.head.appendChild(style);
        }

        return true;
      } catch (error) {
        console.error("[FS Custom Badges] Failed to load badges:", error);
        return false;
      }
    }

    function getProductCards() {
      const selectors = [
        ".card-wrapper",
        ".card.product-card",
        ".product-card",
        "product-card",
        ".grid__item .card",
        ".grid__item",
        "[data-product-id]"
      ];

      const cards = new Set();
      selectors.forEach((selector) => {
        document.querySelectorAll(selector).forEach((element) => cards.add(element));
      });

      return Array.from(cards);
    }

    function normalizeProductId(value) {
      if (!value) return null;
      const stringValue = String(value);
      const match = stringValue.match(/(\d+)(?!.*\d)/);
      return match ? match[1] : null;
    }

    function parseMoney(value) {
      if (!value) return 0;
      let cleaned = String(value).replace(/[^\d.,-]/g, "").trim();
      if (!cleaned) return 0;

      if (cleaned.includes(",") && cleaned.includes(".")) {
        const lastComma = cleaned.lastIndexOf(",");
        const lastDot = cleaned.lastIndexOf(".");
        if (lastComma > lastDot) {
          cleaned = cleaned.replace(/\./g, "").replace(",", ".");
        } else {
          cleaned = cleaned.replace(/,/g, "");
        }
      } else if (cleaned.includes(",")) {
        const parts = cleaned.split(",");
        if (parts.length === 2 && parts[1].length <= 2) {
          cleaned = cleaned.replace(",", ".");
        } else {
          cleaned = cleaned.replace(/,/g, "");
        }
      }

      const number = parseFloat(cleaned);
      return Number.isNaN(number) ? 0 : number;
    }

    function getProductData(card) {
      let productId = null;
      let productHandle = null;

      if (card.dataset.productId) {
        productId = normalizeProductId(card.dataset.productId);
      }

      const productLink = card.querySelector('a[href*="/products/"]');
      if (productLink) {
        const href = productLink.getAttribute("href") || "";
        const match = href.match(/\/products\/([^/?#]+)/i);
        if (match) {
          productHandle = match[1];
          const variantMatch = href.match(/[?&]variant=(\d+)/i);
          if (variantMatch && !productId) {
            productId = normalizeProductId(variantMatch[1]);
          }
        }
      }

      if (!productId) {
        const possibleIdElements = ["[data-product-id]", "[data-product]", "[data-product-handle]"];
        for (const selector of possibleIdElements) {
          const element = card.querySelector(selector);
          if (!element) continue;
          const possibleId = element.dataset.productId || element.dataset.product;
          if (possibleId) {
            productId = normalizeProductId(possibleId);
            if (productId) break;
          }
        }
      }

      let price = 0;
      const priceElement = card.querySelector(".price-item--regular, .price__regular .price-item, .price-item");
      if (priceElement) {
        price = parseMoney(priceElement.textContent);
      }
      if (card.dataset.price) {
        const parsedPrice = parseFloat(card.dataset.price);
        if (!Number.isNaN(parsedPrice)) price = parsedPrice;
      }

      let tags = [];
      if (card.dataset.tags) {
        tags = card.dataset.tags.split(",").map((tag) => tag.trim().toLowerCase()).filter(Boolean);
      }

      let inventory = 999999;
      if (card.dataset.inventory) {
        const parsedInventory = parseInt(card.dataset.inventory, 10);
        if (!Number.isNaN(parsedInventory)) inventory = parsedInventory;
      }

      return { productId, productHandle, tags, price, inventory };
    }

    function isDeviceEligible(badge) {
      const isMobile = window.matchMedia("(max-width: 749px)").matches;
      if (isMobile && badge.hideOnMobile === true) return false;
      if (!isMobile && badge.hideOnDesktop === true) return false;
      return true;
    }

    function isEligible(badge, productData) {
      if (badge.enabled === false || badge.isActive === false || badge.status === "INACTIVE") {
        return false;
      }

      if (!isDeviceEligible(badge)) return false;

      const targetType = badge.targetType || (badge.isGlobal ? "GLOBAL" : "GLOBAL");

      if (targetType === "GLOBAL") return true;

      if (targetType === "SPECIFIC_PRODUCTS") {
        if (!productData.productId || !Array.isArray(badge.productIds)) return false;
        return badge.productIds.some((id) => normalizeProductId(id) === productData.productId);
      }

      if (targetType === "PRODUCT_TAGS") {
        if (!Array.isArray(badge.targetTags) || badge.targetTags.length === 0) return false;
        return productData.tags.some((tag) =>
          badge.targetTags.map(t => String(t).trim().toLowerCase()).includes(String(tag).trim().toLowerCase())
        );
      }

      if (targetType === "INVENTORY_LEVEL") {
        const min = Number(badge.minInventory ?? 0);
        const max = Number(badge.maxInventory ?? 999999);
        return productData.inventory >= min && productData.inventory <= max;
      }

      if (targetType === "PRICE_RANGE") {
        const min = Number(badge.minPrice ?? 0);
        const max = Number(badge.maxPrice ?? 999999999);
        return productData.price >= min && productData.price <= max;
      }

      return false;
    }

    function getMediaElement(card) {
      return (
        card.querySelector(".card__media") ||
        card.querySelector(".media") ||
        card.querySelector(".product-card__image-wrapper") ||
        card.querySelector(".card__inner") ||
        card
      );
    }

    function removeExistingBadges(card) {
      card.querySelectorAll(".fs-custom-storefront-badge").forEach((badge) => badge.remove());
    }

    function renderBadge(card, badge, productData) {
      const mediaElement = getMediaElement(card);
      if (!mediaElement) return;

      if (mediaElement.querySelector(`[data-fs-badge-id="${badge.id}"]`)) return;

      const computedStyle = window.getComputedStyle(mediaElement);
      if (computedStyle.position === "static") {
        mediaElement.style.position = "relative";
      }

      const badgeElement = document.createElement("div");
      badgeElement.className = "fs-custom-storefront-badge";
      badgeElement.dataset.fsBadgeId = badge.id;

      let positionStyle = "top: 10px; left: 10px;";
      switch (badge.position) {
        case "TOP_RIGHT":
          positionStyle = "top: 10px; right: 10px;";
          break;
        case "BOTTOM_LEFT":
          positionStyle = "bottom: 10px; left: 10px;";
          break;
        case "BOTTOM_RIGHT":
          positionStyle = "bottom: 10px; right: 10px;";
          break;
        case "CENTER_OVERLAY":
          positionStyle = "top: 50%; left: 50%; transform: translate(-50%, -50%);";
          break;
        default:
          break;
      }

      const shape = String(badge.shape || "PILL").toUpperCase();
      let radius = `${badge.borderRadius || 8}px`;
      if (shape === "PILL") radius = "999px";
      if (shape === "SHARP") radius = "0px";

      const isOutline = shape === "OUTLINE";
      const isGlass = shape === "GLASSMORPHISM";

      const bgColor = badge.bgColor || "#111827";
      const textColor = badge.textColor || "#FFFFFF";
      const borderColor = badge.borderColor || bgColor;

      badgeElement.style.cssText = `
        position: absolute;
        ${positionStyle}
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: ${badge.paddingY || 4}px ${badge.paddingX || 10}px;
        min-height: 20px;
        background: ${isOutline ? "transparent" : isGlass ? `${bgColor}CC` : bgColor};
        color: ${isOutline ? bgColor : textColor};
        border: ${isOutline ? `1.5px solid ${bgColor}` : `1px solid ${borderColor}`};
        border-radius: ${radius};
        font-size: ${badge.fontSize || 11}px;
        font-weight: ${badge.fontWeight || "700"};
        line-height: 1.2;
        letter-spacing: 0.2px;
        text-transform: uppercase;
        white-space: nowrap;
        z-index: 20;
        box-sizing: border-box;
        pointer-events: auto;
        cursor: pointer;
        box-shadow: 0 3px 10px rgba(0,0,0,0.12);
        ${isGlass ? "backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);" : ""}
        ${badge.customCss ? badge.customCss : ""}
      `;

      if (badge.icon) {
        const icon = document.createElement("span");
        icon.className = "fs-custom-badge-icon";
        icon.textContent = badge.icon;
        icon.style.cssText = `display: inline-flex; align-items: center; line-height: 1;`;
        badgeElement.appendChild(icon);
      }

      const text = document.createElement("span");
      text.className = "fs-custom-badge-text";
      text.textContent = badge.text || "BADGE";
      badgeElement.appendChild(text);

      badgeElement.addEventListener("click", function () {
        trackEvent(badge.id, "CLICK", productData.productId);
      });

      mediaElement.appendChild(badgeElement);
      trackEvent(badge.id, "IMPRESSION", productData.productId);
    }

    function trackEvent(badgeId, eventType, productId) {
      try {
        fetch(`${API_ENDPOINT}?shop=${encodeURIComponent(SHOP_DOMAIN)}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          keepalive: true,
          body: JSON.stringify({ badgeId, eventType, productId })
        }).catch(() => {});
      } catch (error) {}
    }

    function renderAllBadges() {
      if (!badgeConfiguration || badgeConfiguration.length === 0) return;
      const cards = getProductCards();
      if (!cards.length) return;

      cards.forEach((card) => {
        const productData = getProductData(card);
        if (!productData.productId && !productData.productHandle) return;

        removeExistingBadges(card);

        const matchingBadge = badgeConfiguration.find((badge) =>
          isEligible(badge, productData)
        );

        if (matchingBadge) {
          renderBadge(card, matchingBadge, productData);
        }
      });
    }

    async function initialize() {
      if (engineInitialized) {
        renderAllBadges();
        return;
      }
      engineInitialized = true;
      const loaded = await loadBadges();
      if (!loaded) return;
      renderAllBadges();
    }

    document.addEventListener("shopify:section:load", () => setTimeout(renderAllBadges, 150));
    document.addEventListener("shopify:section:reorder", () => setTimeout(renderAllBadges, 150));
    document.addEventListener("shopify:section:select", () => setTimeout(renderAllBadges, 150));

    let renderTimeout = null;
    const observer = new MutationObserver(function () {
      clearTimeout(renderTimeout);
      renderTimeout = setTimeout(renderAllBadges, 250);
    });

    function startObserver() {
      if (!document.body) return;
      observer.observe(document.body, { childList: true, subtree: true });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", function () {
        initialize();
        startObserver();
      });
    } else {
      initialize();
      startObserver();
    }

    let resizeTimeout;
    window.addEventListener("resize", function () {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(renderAllBadges, 250);
    });
  })();
</script>

{% schema %}
{
  "name": "Badge Engine Embed",
  "target": "body",
  "settings": []
}
{% endschema %}