{%- comment -%}
  Product Label Block for Product Details Page (PDP)
{%- endcomment -%}

{% assign current_product = product %}

{% if current_product %}
<div 
  class="fs-pdp-label-wrapper" 
  id="fs-pdp-label-{{ block.id }}"
  data-product-id="{{ current_product.id }}"
  data-product-tags="{{ current_product.tags | join: ',' | downcase }}"
  data-product-price="{{ current_product.price | divided_by: 100.0 }}"
  data-product-inventory="{% if current_product.selected_or_first_available_variant.inventory_management %}{{ current_product.selected_or_first_available_variant.inventory_quantity }}{% else %}999{% endif %}"
  style="
    --label-bg-color: {{ block.settings.bg_color }};
    --label-text-color: {{ block.settings.text_color }};
    --label-font-size: {{ block.settings.font_size }}px;
    --label-border-radius: {{ block.settings.border_radius }}px;
    --label-padding-v: {{ block.settings.padding_vertical }}px;
    --label-padding-h: {{ block.settings.padding_horizontal }}px;
    --label-margin-top: {{ block.settings.margin_top }}px;
    --label-margin-bottom: {{ block.settings.margin_bottom }}px;
    --label-letter-spacing: {{ block.settings.letter_spacing }}px;
  "
>
  {%- comment -%} Show fallback badge on both Theme Editor and Live Storefront until API loads {%- endcomment -%}
  <span class="fs-pdp-badge fs-shape-{{ block.settings.badge_shape }}">
    {% if block.settings.show_icon and block.settings.default_icon != blank %}
      <span class="fs-badge-icon">{{ block.settings.default_icon }}</span>
    {% endif %}
    <span class="fs-badge-text">{{ block.settings.preview_text | default: "⚡ LIMITED STOCK" }}</span>
  </span>
</div>

<style>
  .fs-pdp-label-wrapper {
    display: flex;
    align-items: center;
    margin-top: var(--label-margin-top);
    margin-bottom: var(--label-margin-bottom);
    width: 100%;
  }

  .fs-pdp-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--label-bg-color);
    color: var(--label-text-color);
    font-size: var(--label-font-size);
    font-weight: 700;
    padding: var(--label-padding-v) var(--label-padding-h);
    border-radius: var(--label-border-radius);
    letter-spacing: var(--label-letter-spacing);
    text-transform: uppercase;
    line-height: 1.2;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .fs-pdp-badge.fs-shape-pill { border-radius: 50px; }
  .fs-pdp-badge.fs-shape-rounded { border-radius: 6px; }
  .fs-pdp-badge.fs-shape-sharp { border-radius: 0px; }
  .fs-pdp-badge.fs-shape-outline {
    background-color: transparent !important;
    border: 2px solid var(--label-bg-color);
    color: var(--label-bg-color);
  }

  .fs-badge-icon { display: inline-flex; align-items: center; }
</style>

<script>
  (function() {
    const wrapper = document.getElementById("fs-pdp-label-{{ block.id }}");
    if (!wrapper) return;

    const API_ENDPOINT = '/apps/badges';
    const shop = "{{ shop.permanent_domain }}";

    function normalizeProductId(value) {
      if (!value) return null;
      const match = String(value).match(/(\d+)(?!.*\d)/);
      return match ? match[1] : null;
    }

    const productId = normalizeProductId(wrapper.dataset.productId);
    const tags = wrapper.dataset.productTags ? wrapper.dataset.productTags.split(',').map(t => t.trim().toLowerCase()) : [];
    const price = parseFloat(wrapper.dataset.productPrice || '0');
    const inventory = parseInt(wrapper.dataset.productInventory || '999', 10);

    if (!productId) return;

    function isDeviceEligible(badge) {
      const isMobile = window.matchMedia("(max-width: 749px)").matches;
      if (isMobile && badge.hideOnMobile === true) return false;
      if (!isMobile && badge.hideOnDesktop === true) return false;
      return true;
    }

    function isEligible(badge) {
      if (badge.enabled === false || badge.isActive === false || badge.status === 'INACTIVE') {
        return false;
      }

      if (!isDeviceEligible(badge)) return false;

      const targetType = badge.targetType || (badge.isGlobal ? 'GLOBAL' : 'GLOBAL');

      if (targetType === 'GLOBAL') return true;

      if (targetType === 'SPECIFIC_PRODUCTS' && Array.isArray(badge.productIds)) {
        return badge.productIds.some(id => normalizeProductId(id) === productId);
      }

      if (targetType === 'PRODUCT_TAGS' && Array.isArray(badge.targetTags)) {
        return tags.some(tag =>
          badge.targetTags.map(t => String(t).trim().toLowerCase()).includes(tag)
        );
      }

      if (targetType === 'INVENTORY_LEVEL') {
        const min = Number(badge.minInventory ?? 0);
        const max = Number(badge.maxInventory ?? 999999);
        return inventory >= min && inventory <= max;
      }

      if (targetType === 'PRICE_RANGE') {
        const min = Number(badge.minPrice ?? 0);
        const max = Number(badge.maxPrice ?? 999999999);
        return price >= min && price <= max;
      }

      return false;
    }

    async function fetchPDPLabel() {
      try {
        const response = await fetch(`${API_ENDPOINT}?shop=${encodeURIComponent(shop)}`);
        if (!response.ok) {
          console.warn("[PDP Label] App Proxy server response error:", response.status);
          return;
        }

        const data = await response.json();
        if (!data.badges || data.badges.length === 0) return;

        const matchingBadge = data.badges.find(badge => isEligible(badge));

        if (matchingBadge) {
          const iconHtml = matchingBadge.icon ? `<span class="fs-badge-icon">${matchingBadge.icon}</span>` : "";
          const badgeShape = (matchingBadge.shape || "{{ block.settings.badge_shape }}").toLowerCase();

          if (matchingBadge.bgColor) wrapper.style.setProperty('--label-bg-color', matchingBadge.bgColor);
          if (matchingBadge.textColor) wrapper.style.setProperty('--label-text-color', matchingBadge.textColor);

          wrapper.innerHTML = `
            <span class="fs-pdp-badge fs-shape-${badgeShape}" data-badge-id="${matchingBadge.id}">
              ${iconHtml}
              <span class="fs-badge-text">${matchingBadge.text}</span>
            </span>
          `;

          const badgeEl = wrapper.querySelector('.fs-pdp-badge');
          
          badgeEl.addEventListener('click', () => {
            fetch(`${API_ENDPOINT}?shop=${encodeURIComponent(shop)}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ badgeId: matchingBadge.id, eventType: 'CLICK', productId }),
            }).catch(() => {});
          });

          fetch(`${API_ENDPOINT}?shop=${encodeURIComponent(shop)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ badgeId: matchingBadge.id, eventType: 'IMPRESSION', productId }),
          }).catch(() => {});
        }
      } catch (err) {
        console.error("[PDP Label] API Sync failed, showing theme block default:", err);
      }
    }

    // Always attempt to fetch API for live badge overrides
    fetchPDPLabel();
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Product Badge Label",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "🎨 Label Styling"
    },
    {
      "type": "select",
      "id": "badge_shape",
      "label": "Badge Shape",
      "options": [
        { "value": "rounded", "label": "Rounded Corners" },
        { "value": "pill", "label": "Pill / Capsule" },
        { "value": "sharp", "label": "Sharp Square" },
        { "value": "outline", "label": "Modern Outline" }
      ],
      "default": "rounded"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 1
    },
    {
      "type": "header",
      "content": "📐 Spacing & Padding"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 2,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 6,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Horizontal Padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Top Margin",
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 12
    },
    {
      "type": "header",
      "content": "👁️ Badge Preview Text"
    },
    {
      "type": "text",
      "id": "preview_text",
      "label": "Default/Fallback Text",
      "default": "⚡ LIMITED STOCK"
    }
  ]
}
{% endschema %}