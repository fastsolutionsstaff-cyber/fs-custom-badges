{%- comment -%}
  Product Label Block for Product Details Page (PDP) - Pro
{%- endcomment -%}

{% assign current_product = product %}

{% if current_product %}
<div 
  class="fs-pdp-label-wrapper" 
  id="fs-pdp-label-{{ block.id }}"
  data-product-id="{{ current_product.id }}"
  data-product-tags="{{ current_product.tags | join: ',' | downcase }}"
  data-product-price="{{ current_product.price | divided_by: 100.0 }}"
  style="
    --label-bg-color: {{ block.settings.bg_color }};
    --label-text-color: {{ block.settings.text_color }};
    --label-font-size: {{ block.settings.font_size }}px;
    --label-border-radius: {{ block.settings.border_radius }}px;
    --label-padding-v: {{ block.settings.padding_vertical }}px;
    --label-padding-h: {{ block.settings.padding_horizontal }}px;
    --label-margin-top: {{ block.settings.margin_top }}px;
    --label-margin-bottom: {{ block.settings.margin_bottom }}px;
  "
>
  <span class="fs-pdp-badge fs-shape-{{ block.settings.badge_shape }}">
    {% if block.settings.show_icon and block.settings.default_icon != blank %}
      <span class="fs-badge-icon">{{ block.settings.default_icon }}</span>
    {% endif %}
    <span class="fs-badge-text">{{ block.settings.preview_text | default: "⚡ LIMITED STOCK" }}</span>
  </span>
</div>

<style>
  .fs-pdp-label-wrapper {
    display: flex;
    align-items: center;
    margin-top: var(--label-margin-top);
    margin-bottom: var(--label-margin-bottom);
    width: 100%;
  }
  .fs-pdp-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--label-bg-color);
    color: var(--label-text-color);
    font-size: var(--label-font-size);
    font-weight: 700;
    padding: var(--label-padding-v) var(--label-padding-h);
    border-radius: var(--label-border-radius);
    text-transform: uppercase;
    box-shadow: 0 4px 14px rgba(0,0,0,0.12);
  }
  .fs-pdp-badge.fs-shape-pill { border-radius: 999px; }
  .fs-pdp-badge.fs-shape-rounded { border-radius: 12px; }
  .fs-pdp-badge.fs-shape-sharp { border-radius: 0px; }
</style>

<script>
  (function() {
    const wrapper = document.getElementById("fs-pdp-label-{{ block.id }}");
    if (!wrapper) return;

    const API_ENDPOINT = '/apps/badges';
    const shop = "{{ shop.permanent_domain }}";

    function normalizeProductId(value) {
      if (!value) return null;
      const match = String(value).match(/(\d+)/);
      return match ? match[1] : null;
    }

    const productId = normalizeProductId(wrapper.dataset.productId);
    if (!productId) return;

    async function fetchPDPLabel() {
      try {
        const response = await fetch(`${API_ENDPOINT}?shop=${encodeURIComponent(shop)}&productId=${productId}`);
        if (!response.ok) return;

        const data = await response.json();
        if (!data.badges || data.badges.length === 0) return;

        const matchingBadge = data.badges[0];
        if (matchingBadge) {
          const iconHtml = matchingBadge.icon ? `<span>${matchingBadge.icon}</span>` : "";
          wrapper.innerHTML = `
            <span class="fs-pdp-badge" style="background-color: ${matchingBadge.bgColor}; color: ${matchingBadge.textColor}; border-radius: 999px;">
              ${iconHtml}
              <span>${matchingBadge.text}</span>
            </span>
          `;
        }
      } catch (err) {
        // Fallback to theme block default
      }
    }

    fetchPDPLabel();
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Product Badge Label Pro",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "badge_shape",
      "label": "Shape",
      "options": [{ "value": "pill", "label": "Pill" }, { "value": "rounded", "label": "Rounded" }, { "value": "sharp", "label": "Sharp" }],
      "default": "pill"
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#111827" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "range", "id": "font_size", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Font Size", "default": 12 },
    { "type": "text", "id": "preview_text", "label": "Default Text", "default": "⚡ LIMITED STOCK" }
  ]
}
{% endschema %}